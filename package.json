{
  "name": "infinite-canvas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/main.ts",
    "test": "tsx --test tests/core.test.ts tests/images.test.ts tests/catalog.test.ts tests/multimodal.test.ts tests/assets-frames.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:e2e:multimodal": "playwright test --config playwright.multimodal.config.ts",
    "test:all": "tsx --test --test-concurrency=2 tests/core.test.ts tests/images.test.ts tests/catalog.test.ts tests/multimodal.test.ts tests/channels-migration.test.ts tests/pricing.test.ts tests/assets.test.ts tests/assets-frames.test.ts tests/registration.test.ts tests/workflow-frames.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@google/model-viewer": "4.4.0",
    "@happy-oyster/js-sdk-core": "0.1.6",
    "@nestjs/common": "^10.4.20",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "@types/qrcode": "1.5.6",
    "@xyflow/react": "^12.8.5",
    "adm-zip": "0.6.1",
    "ali-oss": "^6.23.0",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "fast-xml-parser": "5.11.2",
    "file-type": "^20.5.0",
    "helmet": "^8.1.0",
    "idb-keyval": "^6.2.2",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "pdf-lib": "1.17.1",
    "pg": "^8.16.3",
    "qrcode": "1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.4",
    "undici": "^6.21.3",
    "ws": "8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/adm-zip": "0.5.8",
    "@types/ali-oss": "^6.23.3",
    "@types/archiver": "^6.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
